{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Transcriber",
  "version": "0.1.0",
  "identifier": "com.videotranscriber.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Video Transcriber",
        "width": 800,
        "height": 700,
        "minWidth": 560,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
      "active": true,
      "targets": "all",
      "resources": ["python/transcribe_worker.py", "runtime/**/*"],
      "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
